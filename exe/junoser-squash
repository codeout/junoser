#!/usr/bin/env ruby
# frozen_string_literal: true

require 'English'
require 'optparse'

$LOAD_PATH << File.expand_path('../../lib', File.realpath(__FILE__))
require 'junoser/squash'

command = :squash
opts = OptionParser.new do |opts|
  opts.banner = 'junoser-squash: squash config file.'
  opts.define_head 'Usage: junoser-squash [path]'

  opts.on_tail '-h', '--help', 'Show this message' do
    puts opts
    exit
  end
end
opts.parse!
case command
when :squash
  puts Junoser::Squash.new($DEFAULT_INPUT).transform
else
  puts opts
  abort
end
